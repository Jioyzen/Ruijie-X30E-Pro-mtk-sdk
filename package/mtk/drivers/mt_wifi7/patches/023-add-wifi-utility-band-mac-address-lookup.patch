From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] mt_wifi: Add per-band MAC address lookup

Boards can provide radio MAC addresses through device tree or NVMEM.
Call wifi_utility after DAT and module parameter overrides to obtain
the address for the current band.

The OF address is optional. Keep the EEPROM address on any lookup failure,
including a provider that is not ready, so interface initialization can
continue. Record errors other than -ENOENT through the driver warning
logger, including the device, band and error code.

Read into a temporary buffer and replace the EEPROM address only on
success. The OF helper can populate its output before failing to cache
the address in the device tree.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/mt_wifi/hw_ctrl/eeprom.c
+++ b/mt_wifi/hw_ctrl/eeprom.c
@@ -26,6 +26,10 @@
 */
 #include "rt_config.h"
 
+#ifdef HWIFI_SUPPORT
+extern int mt_mac_address_read_wifi(struct device *dev, u32 band_idx, u8 *addr);
+#endif
+
 struct chip_map {
 	UINT32 ChipVersion;
 	RTMP_STRING *name;
@@ -499,6 +503,12 @@ INT NICReadEEPROMParameters(
 	struct physical_device *ph_dev = pAd->physical_dev;
 	UINT16 BandSel = 0;
 	struct _RTMP_CHIP_OP *ops = hc_get_chip_ops(pAd->hdev_ctrl);
+	BOOLEAN is_mac_from_of = FALSE;
+#ifdef HWIFI_SUPPORT
+	POS_COOKIE obj = (POS_COOKIE)pAd->OS_Cookie;
+	UCHAR of_mac[MAC_ADDR_LEN];
+	int mac_ret = -ENOENT;
+#endif
 
 	os_zero_mem(&Antenna, sizeof(EEPROM_ANTENNA_STRUC));
 
@@ -583,8 +593,31 @@ INT NICReadEEPROMParameters(
 		MTWF_DBG(pAd, DBG_CAT_HW, CATHW_EEPROM, DBG_LVL_INFO,
 			"Use the MAC address what is assigned from Moudle Parameter.\n");
 	} else {
+#ifdef HWIFI_SUPPORT
+		/* Keep the EEPROM address if the lookup writes output then fails. */
+		if (obj && obj->mac_dev && obj->mac_dev->hw.pdev)
+			mac_ret = mt_mac_address_read_wifi(obj->mac_dev->hw.pdev,
+							   hc_get_hw_band_idx(pAd),
+							   of_mac);
+
+		if (mac_ret && mac_ret != -ENOENT)
+			MTWF_DBG(pAd, DBG_CAT_HW, CATHW_EEPROM, DBG_LVL_WARN,
+				 "OF MAC lookup for band %u on %s failed (%d), using EEPROM\n",
+				 hc_get_hw_band_idx(pAd), dev_name(obj->mac_dev->hw.pdev),
+				 mac_ret);
+
+		if (!mac_ret) {
+			COPY_MAC_ADDR(pAd->PermanentAddress, of_mac);
+			pAd->bRandomMac = FALSE;
+			is_mac_from_of = TRUE;
+		}
+#endif
 		COPY_MAC_ADDR(pAd->CurrentAddress, pAd->PermanentAddress);
-		if (pAd->bRandomMac) {
+		if (is_mac_from_of)
+			MTWF_DBG(pAd, DBG_CAT_HW, CATHW_EEPROM, DBG_LVL_INFO,
+				 "Use OF band MAC: =" MACSTR "\n",
+				 MAC2STR(pAd->CurrentAddress));
+		else if (pAd->bRandomMac) {
 			MTWF_DBG(pAd, DBG_CAT_HW, CATHW_EEPROM, DBG_LVL_WARN,
 			"\n\n\n\n\n\033[1;31m[Wanrning] you are using random MAC!!!\033[0m\n"
 			"\033[1;31m[Wanrning]please update the MAC before use the board!!!!!!!\033[0m\n\n\n\n\n");
